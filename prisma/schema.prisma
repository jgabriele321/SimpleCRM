generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Deal {
  id                Int       @id @default(autoincrement())
  title             String
  personName        String?
  companyName       String?
  stage             String    @default("signal")
  tags              String    @default("[]")
  priority          String    @default("medium")
  expectedValue     Float     @default(0)
  closeProbability  Int       @default(50)
  expectedCloseDate DateTime?
  lastContactDate   DateTime?
  nextActionDate    DateTime?
  nextAction        String?
  gatekeeperName    String?
  gatekeeperLastContacted DateTime?
  stageChangedAt    DateTime?
  proposalSentAt    DateTime?
  lossReason        String?
  isGatekept        Boolean   @default(false)
  notes             String?
  isTargeted        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


